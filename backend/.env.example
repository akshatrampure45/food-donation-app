# Copy this file to ".env" and fill in your values.

# ---------- Database ----------
# LOCAL TESTING (easiest, no MySQL needed): keep the next line as is.
# For Aiven MySQL: delete/blank DATABASE_URL and fill the DB_* values below.
DATABASE_URL=sqlite:///./food_donation.db

DB_HOST=your-service.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your_password
DB_NAME=defaultdb
# Path to Aiven ca.pem (download from Aiven console). On Render use: ./ca.pem
DB_SSL_CA=

# ---------- App ----------
SECRET_KEY=change-this-to-a-long-random-string
# Comma-separated list of frontend URLs allowed to call this API
FRONTEND_URL=http://localhost:5173
# true = OTPs are printed in the server console AND returned in the API response (for testing only!)
# false = real SMS/email only. MUST be false in production.
DEV_MODE=true

# ---------- Admin account (auto-created at startup) ----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# ---------- OTP providers ----------
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Food Donation Platform
